<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>YuCap</RootNamespace>
    <AssemblyName>YuCap</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.15.1</Version>
    <Product>YuCap</Product>
    <Copyright>© 2026 YUGO</Copyright>
    <AssemblyTitle>YuCap - キャプチャビューア</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Shaders\*.hlsl" LogicalName="Shaders.%(Filename)%(Extension)" />
    <EmbeddedResource Include="third_party/FidelityFX-FSR1/ffx_a.h" LogicalName="Shaders.ffx_a.h" />
    <EmbeddedResource Include="third_party/FidelityFX-FSR1/ffx_fsr1.h" LogicalName="Shaders.ffx_fsr1.h" />
    <!-- 自分専用モデルの学習用スクリプト: exe に埋め込み、学習のときに %LOCALAPPDATA%\YuCapTrain	ools へ取り出す -->
    <EmbeddedResource Include="tools\*.py" LogicalName="Tools.%(Filename)%(Extension)" />
    <EmbeddedResource Include="tools\setup_train_env.ps1" LogicalName="Tools.setup_train_env.ps1" />
    <EmbeddedResource Include="third_party\Anime4K\Anime4K_Upscale_CNN_x2_*.glsl" LogicalName="Tools.glsl.%(Filename)%(Extension)" />
    <EmbeddedResource Include="third_party\Anime4K\LICENSE" LogicalName="Tools.glsl.LICENSE" />
  </ItemGroup>

</Project>
